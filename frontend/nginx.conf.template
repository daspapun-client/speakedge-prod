# SpeakEdge SPA + API reverse proxy.
# ${BACKEND_URL} is substituted at container start (see Dockerfile).
# TLS is expected to terminate in front of this container (Railway/ALB/Caddy);
# add a listen 443 block here only if this Nginx is the public edge.

# WebSocket upgrade plumbing. nginx's stock nginx.conf does not define
# $connection_upgrade, and referencing an undefined variable is a startup error —
# so this map has to live here. conf.d/*.conf is included in the http context,
# which is where `map` belongs.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Uploads: videos are capped at MAX_VIDEO_MB=200 backend-side; leave headroom.
    client_max_body_size 220m;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/manifest+json;

    # Container health (does not touch the backend).
    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # ---- API + WebSockets (community chat, teacher batch chat) ----
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;               # keep chat/SSE-ish responses prompt
        proxy_read_timeout 3600s;             # long-lived WebSocket connections
        proxy_send_timeout 3600s;
    }

    # ---- Uploaded media (only when STORAGE_BACKEND=local) ----
    location /media/ {
        proxy_pass       ${BACKEND_URL};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Static bundle ----
    # Vite emits content-hashed filenames under /assets — safe to cache forever.
    location /assets/ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    # The PWA shell and service worker must always be revalidated, otherwise a
    # deploy can be pinned behind a stale cached sw.js / index.html.
    #
    # NB: nginx's add_header does NOT merge with the parent block — a location
    # with any add_header of its own drops every inherited one. The SPA fallback
    # below internally redirects to /index.html, so that block serves nearly
    # every page view and has to restate the security headers itself.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
        add_header X-Frame-Options SAMEORIGIN;
        add_header Referrer-Policy strict-origin-when-cross-origin;
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
    }

    # SPA fallback: real files win, everything else renders the React router.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Basic hardening (CSP intentionally omitted — add once asset origins settle).
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy strict-origin-when-cross-origin;
}
