# Copy to .env and adjust. All values have safe local defaults.
APP_NAME=SpeakEdge
ENV=local
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production

# CORS (frontend dev origin)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Public site origin — used to build links inside emails (password reset).
# In production FastAPI serves the SPA itself, so set this to the site URL.
PUBLIC_BASE_URL=http://localhost:5173

# MongoDB (required)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=speakedge

# Redis (optional — leave blank to use in-memory fallback)
REDIS_URL=

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60

# Seed super admin
SUPER_ADMIN_EMAIL=admin@speakedge.in
SUPER_ADMIN_PASSWORD=Admin@12345

# Storage. `local` writes under UPLOAD_DIR and serves it from the /media mount;
# `s3` needs the four S3_* values below. S3_ENDPOINT stays empty for real AWS
# (boto3 derives the regional endpoint) and is set only for an S3-compatible
# service such as Cloudflare R2 or MinIO. S3_BUCKET is the bucket NAME — boto3
# rejects an `arn:aws:s3:::<name>` here.
STORAGE_BACKEND=local
UPLOAD_DIR=storage/uploads
MAX_PHOTO_KB=120
MAX_ID_PROOF_KB=500
MAX_VIDEO_MB=200
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
# Lifetime of a presigned /media link, seconds. Minted per request.
S3_PRESIGN_EXPIRY=3600

# Razorpay. Keep the placeholder key id to use the offline/test-order fallback
# (no gateway calls, orders auto-verify). A real rzp_test_/rzp_live_ id turns on
# the live path: real orders + mandatory signature verification.
# Webhook: POST https://<host>/api/v1/payments/webhook, event payment.captured,
# signed with RAZORPAY_WEBHOOK_SECRET — required to reconcile guest book orders.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=test_secret
RAZORPAY_WEBHOOK_SECRET=webhook_secret

# SMTP (Mailhog defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@speakedge.in
SMTP_TLS=false

# Web Push (optional — generate keys: pip install pywebpush && python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PUBLIC', v.public_key); print('PRIVATE', v.private_key)")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@speakedge.in
